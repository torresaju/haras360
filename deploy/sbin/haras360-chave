#!/usr/bin/env bash
# Instala ou troca a chave pública usada para conferir os pacotes de atualização.
# Uso: sudo haras360-chave chave-publica.pem
set -euo pipefail
. /usr/local/lib/haras360/comum.sh
exige_root
[ $# -eq 1 ] && [ -f "$1" ] || falha "Uso: sudo haras360-chave chave-publica.pem"
python3 - "$1" <<'PY' || falha "Arquivo não é uma chave pública Ed25519 em formato PEM."
import sys
from cryptography.hazmat.primitives.serialization import load_pem_public_key
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
k = load_pem_public_key(open(sys.argv[1], "rb").read())
assert isinstance(k, Ed25519PublicKey)
PY
DIGITAL="$(python3 /usr/local/sbin/haras360-verificar --impressao "$1")"
install -m 644 -o root -g root "$1" "$H360_ETC/chave-publica.pem"
auditar parametro_alterado "chave pública de atualização trocada"
info "Chave pública instalada em $H360_ETC/chave-publica.pem (impressão digital $DIGITAL)"
